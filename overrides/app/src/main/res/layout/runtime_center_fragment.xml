<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#111318" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Wine e Proton" android:textStyle="bold"
            android:textColor="#F3F4F6" android:textSize="25sp"/>
        <TextView android:id="@+id/TVRuntimeRootfs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="18dp"
            android:text="Verificando sistema" android:textColor="#9BA6B2" android:textSize="12sp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Instalados" android:textStyle="bold" android:textSize="15sp"
            android:textColor="#E5E7EB" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/enhanced_library_card"
            android:padding="14dp" android:orientation="vertical">
            <TextView android:id="@+id/TVRuntimeInstalledWine"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Carregando versões" android:textSize="13sp"
                android:textColor="#B6BEC8" android:paddingBottom="8dp"/>
            <Button android:id="@+id/BTImportWine"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Importar pacote Wine" android:textAllCaps="false"/>
            <Button android:id="@+id/BTAllWineSettings"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gerenciar versões" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="21dp" android:layout_marginBottom="8dp"
            android:text="Pacotes" android:textStyle="bold" android:textSize="15sp"
            android:textColor="#E5E7EB"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/enhanced_library_card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Os pacotes Proton Bionic podem exigir outro ambiente. O download não instala o Wine."
                android:textColor="#AEB7C3" android:textSize="12sp" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/BTDownloadProtonBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Proton Wine x86_64" android:textAllCaps="false"/>
            <Button android:id="@+id/BTDownloadProtonFex"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Proton Wine ARM64EC" android:textAllCaps="false"/>
            <Button android:id="@+id/BTOpenProtonReleases"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ver lançamentos" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="21dp" android:layout_marginBottom="8dp"
            android:text="Contêineres" android:textStyle="bold" android:textSize="15sp"
            android:textColor="#E5E7EB"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp"
            android:background="@drawable/enhanced_library_card">
            <Button android:id="@+id/BTCreateWineContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Criar contêiner" android:textAllCaps="false"/>
            <Button android:id="@+id/BTRuntimeHelp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ajuda de compatibilidade" android:textAllCaps="false"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginBottom="14dp"
            android:text="Box64 é o caminho padrão. ARM64EC e FEXCore ainda são experimentais."
            android:gravity="center" android:textSize="11sp" android:textColor="#89939F"/>
    </LinearLayout>
</ScrollView>
