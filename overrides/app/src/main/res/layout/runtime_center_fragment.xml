<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/enhanced_hero"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GERENCIADOR DE RUNTIMES"
                android:textColor="#7DD3FC"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:textSize="11sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wine &amp; Proton"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="27sp"/>
            <TextView
                android:id="@+id/TVRuntimeRootfs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Verificando sistema..."
                android:textColor="#CDDCF1"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="1   BAIXAR WINE / PROTON"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#7DD3FC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/enhanced_library_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecione a versão de acordo com o tradutor"
                android:textColor="#F8FAFC"
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:text="Wine Type (.wcp.xz), não Proton Type (.wcp). As builds Bionic podem exigir componentes adicionais."
                android:textColor="#CBD5E1"
                android:textSize="12sp"/>
            <Button
                android:id="@+id/BTDownloadProtonBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Baixar Proton Wine x86_64 • Box64"/>
            <Button
                android:id="@+id/BTDownloadProtonFex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Baixar Proton Wine ARM64EC • FEXCore"/>
            <Button
                android:id="@+id/BTOpenProtonReleases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Ver outras versões oficiais"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="2   INSTALAR E GERENCIAR"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textSize="13sp"
            android:textColor="#7DD3FC"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/enhanced_library_card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Versões Wine detectadas"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>
            <TextView
                android:id="@+id/TVRuntimeInstalledWine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="Carregando Wine..."
                android:textSize="13sp"
                android:textColor="#CBD5E1"/>
            <Button
                android:id="@+id/BTImportWine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Importar Wine ou Proton baixado"/>
            <Button
                android:id="@+id/BTAllWineSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Gerenciar versões Wine instaladas"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="3   ATIVAR PARA UM JOGO"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textSize="13sp"
            android:textColor="#7DD3FC"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/enhanced_library_card"
            android:padding="16dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escolha a versão Wine num NOVO contêiner. Depois configure Box64 ou FEXCore em Variáveis de ambiente."
                android:textColor="#CBD5E1"
                android:textSize="13sp"/>
            <Button
                android:id="@+id/BTCreateWineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Criar contêiner com Wine escolhido"/>
            <Button
                android:id="@+id/BTRuntimeHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:allCaps="false"
                android:text="Como escolher Wine, Box64 e FEXCore"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingBottom="24dp"
            android:text="FEXCore/Proton ARM64EC experimental. Não substitua o Wine de um contêiner já existente sem backup."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
